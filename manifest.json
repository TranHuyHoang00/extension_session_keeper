{
  "manifest_version": 3,
  "name": "Session Keeper",
  "version": "1.0.1",
  "description": "Extension Session Keeper",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "alarms",
    "tabs",
    "storage",
    "notifications",
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Session Keeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  }
}
